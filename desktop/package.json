{
  "name": "kenz",
  "productName": "Kenz",
  "version": "1.2.0",
  "private": true,
  "description": "كنز — برنامج محاسبة عربي (تطبيق سطح المكتب)",
  "author": "كنز",
  "homepage": "https://ooo518106-rgb.github.io/ahsebha/",
  "license": "UNLICENSED",
  "main": "main.js",
  "desktopName": "kenz.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.ooo518106-rgb.ahsebha",
    "productName": "Kenz",
    "copyright": "كنز",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "policy.js", "offline-site.js", "offline.html", "package.json"],
    "extraResources": [{ "from": "../ahsebha", "to": "ahsebha", "filter": ["**/*", "!store/**", "!test/**", "!package.json", "!**/*.md"] }],
    "asar": true,
    "electronLanguages": ["ar", "en-US"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "كنز",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Kenz-Setup.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Kenz-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "كنز",
        "NSCameraUsageDescription": "لقراءة الباركود وتصوير الإيصالات والفواتير."
      }
    },
    "dmg": { "title": "Kenz" },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "kenz",
      "synopsis": "برنامج محاسبة عربي",
      "artifactName": "Kenz-linux-x64.${ext}",
      "syncDesktopName": true
    }
  }
}
